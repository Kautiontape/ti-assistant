# Copy to .env and fill in. None of these are secrets: the Firebase web
# config ships to every browser anyway. Find it in the Firebase console under
# Project settings -> General -> Your apps -> Web app -> SDK setup and config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL players open; used for QR codes and share links.
NEXT_PUBLIC_BASE_URL=https://ti.example.com

# Where the app container listens on the host.
TI_BIND=127.0.0.1
TI_PORT=3000

# Vault item holding the service account JSON (minified to one line).
TI_FIREBASE_SA_ITEM=personal/ti-assistant-firebase-sa
